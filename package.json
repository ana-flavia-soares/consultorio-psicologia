{
  "name": "consultorio-psicologia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sistema de agenda, prontuário e financeiro para consultório de psicologia, com criptografia no navegador.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:crypto && npm run test:db",
    "test:crypto": "node --test tests/*.test.ts",
    "test:db": "bash scripts/test-db.sh",
    "audit": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
