# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API). A chave "anon" é pública; quem protege os dados é o banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# Identidade exibida nas telas (opcional)
VITE_PRO_NAME=Nome Sobrenome
VITE_PRO_ROLE=Psicóloga
VITE_PRO_FIRST_NAME=Nome
